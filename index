<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Guillaume Avenel – Formateur professionnel d'adultes</title>
<meta name="description" content="Formateur professionnel d'adultes : formation, bilan de compétences, VAE, premiers secours en santé mentale.">
<meta name="theme-color" content="#ffffff">
<meta property="og:title" content="Guillaume Avenel – Formateur professionnel d'adultes">
<meta property="og:description" content="Formation, bilan de compétences, VAE, premiers secours en santé mentale.">
<style>
  :root{
    --bg:#ffffff; --surface:#FAFAF8; --ink:#1C1B1A; --muted:#6B6864; --line:rgba(28,27,26,.11);
    --accent:#52796F; --accent-ink:#ffffff; --accent-soft:rgba(82,121,111,.11);
    --glass:rgba(255,255,255,.76);
    --ease-out:cubic-bezier(0.23,1,0.32,1);
    color-scheme:light;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
  body{
    background:var(--bg);color:var(--ink);
    font:100%/1.6 system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",sans-serif;
    font-optical-sizing:auto;-webkit-font-smoothing:antialiased;
    padding-bottom:env(safe-area-inset-bottom);
  }
  a{color:inherit}
  .wrap{max-width:720px;margin:0 auto;padding:0 20px}

  /* ---------- Barre translucide ---------- */
  .bar{
    position:sticky;top:0;z-index:20;
    background:var(--glass);
    -webkit-backdrop-filter:blur(18px) saturate(180%);backdrop-filter:blur(18px) saturate(180%);
    border-bottom:1px solid transparent;
    transition:border-color 200ms ease-out;
  }
  .bar.show{border-bottom-color:var(--line)}
  .bar .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;height:56px}
  .brand{display:flex;align-items:center;gap:10px;min-width:0;text-decoration:none}
  .mono-sm{
    flex-shrink:0;width:30px;height:30px;border-radius:50%;
    background:var(--accent);color:var(--accent-ink);
    display:grid;place-items:center;font-size:.72rem;font-weight:650;letter-spacing:.04em;
  }
  .brand-name{
    font-weight:600;font-size:.95rem;letter-spacing:-.005em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
    opacity:0;transform:translateY(4px);
    transition:opacity 200ms ease-out,transform 200ms ease-out;
  }
  .bar.show .brand-name{opacity:1;transform:none}
  .bar-cta{
    flex-shrink:0;font-size:.9rem;font-weight:600;text-decoration:none;
    padding:7px 14px;border-radius:999px;border:1px solid var(--line);
    transition:background-color 150ms ease,transform 120ms ease-out;
  }
  .bar-cta:active{transform:scale(.97)}
  @media (hover:hover) and (pointer:fine){ .bar-cta:hover{background:var(--accent-soft)} }
  @media (prefers-reduced-transparency: reduce){
    .bar{background:var(--bg);-webkit-backdrop-filter:none;backdrop-filter:none}
  }

  /* ---------- Hero ---------- */
  .hero{padding:56px 0 40px}
  .portrait{
    width:104px;height:104px;border-radius:50%;overflow:hidden;position:relative;
    background:linear-gradient(145deg,var(--accent),color-mix(in srgb,var(--accent) 60%,#1C1B1A));
    color:var(--accent-ink);display:grid;place-items:center;
    font-size:2rem;font-weight:600;letter-spacing:.03em;
    box-shadow:0 0 0 4px var(--bg),0 0 0 5px var(--line);
  }
  .portrait img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .eyebrow{margin-top:28px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--accent)}
  h1{
    margin-top:10px;font-size:clamp(2.25rem,9vw,3.6rem);line-height:1.04;letter-spacing:-.028em;font-weight:700;
    overflow-wrap:anywhere;text-wrap:balance;
  }
  .role{margin-top:12px;font-size:1.15rem;color:var(--muted);text-wrap:balance}
  .lead{margin-top:18px;font-size:1.05rem;max-width:34em;text-wrap:pretty}
  .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:8px;
    min-height:48px;padding:12px 22px;border-radius:999px;
    font:inherit;font-weight:600;font-size:.98rem;text-decoration:none;cursor:pointer;
    border:1px solid var(--line);background:transparent;color:var(--ink);
    transition:background-color 150ms ease,border-color 150ms ease,transform 120ms ease-out;
  }
  .btn:active{transform:scale(.97)}
  .btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
  .btn[hidden]{display:none}
  @media (hover:hover) and (pointer:fine){
    .btn:hover{background:var(--accent-soft)}
    .btn.primary:hover{background:var(--accent);filter:brightness(1.08)}
  }
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:8px}

  .stats{
    display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin-top:44px;
    border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  }
  .stat{padding:18px 14px 18px 0}
  .stat+.stat{padding-left:16px;border-left:1px solid var(--line)}
  .stat b{display:block;font-size:1.7rem;line-height:1.1;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
  .stat span{display:block;margin-top:4px;font-size:.82rem;color:var(--muted);line-height:1.35;overflow-wrap:anywhere;hyphens:auto}

  /* ---------- Sections ---------- */
  section{padding:44px 0 4px}
  h2{
    font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);
    margin-bottom:20px;
  }
  .about p{font-size:1.12rem;line-height:1.65;text-wrap:pretty}
  .about p+p{margin-top:14px;color:var(--muted)}

  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:12px}
  .card{
    background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:20px;min-width:0;
    transition:border-color 200ms ease;
  }
  @media (hover:hover) and (pointer:fine){ .card:hover{border-color:color-mix(in srgb,var(--accent) 45%,var(--line))} }
  .card h3{font-size:1.02rem;letter-spacing:-.005em;line-height:1.3}
  .card p{margin-top:6px;font-size:.93rem;color:var(--muted);line-height:1.5}

  .timeline{list-style:none}
  .timeline li{position:relative;padding:0 0 26px 26px;min-width:0}
  .timeline li:last-child{padding-bottom:0}
  .timeline li::before{
    content:"";position:absolute;left:0;top:.55em;width:9px;height:9px;border-radius:50%;
    background:var(--accent);box-shadow:0 0 0 4px var(--accent-soft);
  }
  .timeline li::after{
    content:"";position:absolute;left:4px;top:1.6em;bottom:-.4em;width:1px;background:var(--line);
  }
  .timeline li:last-child::after{display:none}
  .t-title{font-weight:600;line-height:1.35;overflow-wrap:anywhere}
  .t-meta{display:block;font-size:.88rem;color:var(--muted);margin-top:2px;overflow-wrap:anywhere}
  .t-desc{margin-top:6px;font-size:.93rem;line-height:1.5;color:var(--muted);text-wrap:pretty}

  .certs{list-style:none;border-top:1px solid var(--line)}
  .certs li{
    display:flex;justify-content:space-between;align-items:baseline;gap:16px;
    padding:14px 0;border-bottom:1px solid var(--line);min-width:0;
  }
  .certs .c-main{min-width:0}
  .certs .c-main b{display:block;font-weight:600;line-height:1.35;overflow-wrap:anywhere}
  .certs .c-main span{display:block;font-size:.88rem;color:var(--muted);margin-top:1px;overflow-wrap:anywhere}
  .certs time{flex-shrink:0;font-size:.85rem;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap}

  /* ---------- Contact ---------- */
  .contact-card{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:8px 20px}
  .c-row{
    display:flex;align-items:center;justify-content:space-between;gap:14px;
    padding:16px 0;border-bottom:1px solid var(--line);min-width:0;
  }
  .c-row:last-child{border-bottom:0}
  .c-row[hidden]{display:none}
  .c-text{min-width:0}
  .c-text small{display:block;font-size:.76rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
  .c-text a{display:block;margin-top:2px;font-weight:600;text-decoration:none;overflow-wrap:anywhere}
  .copy{
    flex-shrink:0;min-height:40px;padding:8px 14px;border-radius:999px;
    font:inherit;font-size:.85rem;font-weight:600;color:var(--accent);
    background:var(--accent-soft);border:0;cursor:pointer;
    transition:background-color 150ms ease,transform 120ms ease-out;
  }
  .copy:active{transform:scale(.97)}
  .copy[hidden]{display:none}

  footer{padding:48px 0 56px;text-align:center;font-size:.82rem;color:var(--muted)}

  /* ---------- Toast ---------- */
  .toast{
    position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom));z-index:50;
    max-width:calc(100vw - 32px);
    padding:11px 18px;border-radius:999px;
    background:var(--ink);color:var(--bg);font-size:.9rem;font-weight:600;
    opacity:0;transform:translate(-50%,10px);pointer-events:none;
    transition:opacity 180ms ease-out,transform 180ms ease-out;
  }
  .toast.on{opacity:1;transform:translate(-50%,0)}

  /* ---------- Apparition (activée seulement si JS actif) ---------- */
  .js .rv{
    opacity:0;transform:translateY(14px);
    transition:opacity 500ms var(--ease-out),transform 500ms var(--ease-out);
    transition-delay:calc(var(--i,0) * 60ms);
  }
  .js .rv.in{opacity:1;transform:none}

  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto}
    .js .rv{transform:none;transition:opacity 200ms ease;transition-delay:0ms}
    .toast{transform:translate(-50%,0)}
    .btn:active,.bar-cta:active,.copy:active{transform:none}
  }
  @media (max-width:420px){
    .stat b{font-size:1.4rem}
    .stat span{font-size:.74rem}
    .stat+.stat{padding-left:12px}
  }
</style>
<script>document.documentElement.classList.add('js')</script>
</head>
<body>

<div class="bar" id="bar">
  <div class="wrap">
    <a class="brand" href="#top" aria-label="Haut de page">
      <span class="mono-sm" aria-hidden="true">GA</span>
      <span class="brand-name">Guillaume Avenel</span>
    </a>
    <a class="bar-cta" href="#contact">Contact</a>
  </div>
</div>

<main id="top">
  <header class="hero">
    <div class="wrap">
      <div class="portrait rv" id="portrait" style="--i:0"><span aria-hidden="true">GA</span></div>
      <p class="eyebrow rv" style="--i:1">Formation · Accompagnement</p>
      <h1 class="rv" style="--i:2">Guillaume Avenel</h1>
      <p class="role rv" style="--i:3">Formateur professionnel d'adultes</p>
      <p class="lead rv" style="--i:4">J'accompagne personnes et équipes : formation, bilan de compétences, VAE et prévention en santé mentale.</p>

      <div class="actions rv" style="--i:5">
        <button class="btn primary" id="vcard" type="button" hidden>Enregistrer le contact</button>
        <a class="btn" id="li-hero" href="https://www.linkedin.com/in/guillaume-avenel-538063204/" target="_blank" rel="noopener">Profil LinkedIn</a>
      </div>

      <div class="stats rv" style="--i:6">
        <div class="stat"><b>12 ans</b><span>d'éducateur spécialisé</span></div>
        <div class="stat"><b>3</b><span>certifications professionnelles</span></div>
        <div class="stat"><b>4</b><span>domaines d'intervention</span></div>
      </div>
    </div>
  </header>

  <section class="about">
    <div class="wrap">
      <h2 class="rv">Approche</h2>
      <p class="rv" style="--i:1">Une approche humaniste : analyser les situations problématiques, identifier des solutions adaptées et accompagner leur mise en œuvre.</p>
      <p class="rv" style="--i:2">Pragmatisme et imagination, avec une lecture renouvelée des situations lorsque cela s'avère nécessaire.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="rv">Domaines d'intervention</h2>
      <div class="cards" data-stagger>
        <article class="card rv"><h3>Formation</h3><p>Communication, outils de PNL, analyse des pratiques professionnelles, projets professionnels.</p></article>
        <article class="card rv"><h3>Bilan de compétences &amp; VAE</h3><p>Accompagnement individuel pour faire le point et valoriser ses acquis.</p></article>
        <article class="card rv"><h3>Consolidation d'équipe</h3><p>Accompagnement d'équipes, notamment dans le secteur médico-social.</p></article>
        <article class="card rv"><h3>Santé mentale</h3><p>Formateur PSSM Jeune, animation d'un point écoute en lycée.</p></article>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="rv">Parcours</h2>
      <ol class="timeline" data-stagger>
        <li class="rv">
          <span class="t-title">Animateur du Point Écoute</span>
          <span class="t-meta">Ensemble scolaire Jeanne d'Arc, Le Havre · depuis oct. 2024</span>
          <p class="t-desc">Prévention en santé mentale auprès des adolescents et jeunes adultes scolarisés.</p>
        </li>
        <li class="rv">
          <span class="t-title">Formateur professionnel d'adultes</span>
          <span class="t-meta">Indépendant · depuis mai 2024</span>
          <p class="t-desc">Analyse des pratiques professionnelles en inter ou intra-entreprise (social, médico-social), formation aux outils de communication et de PNL, accompagnement de projets professionnels.</p>
        </li>
        <li class="rv">
          <span class="t-title">Analyse des pratiques professionnelles</span>
          <span class="t-meta">IFEN · sept. 2024 – juil. 2025</span>
          <p class="t-desc">Accompagnement d'une équipe de professionnels du champ du handicap dans la réflexion sur leurs prises en charge éducatives.</p>
        </li>
        <li class="rv">
          <span class="t-title">Éducateur spécialisé</span>
          <span class="t-meta">Ligue havraise · 2008 – 2020</span>
          <p class="t-desc">Auprès de personnes en situation de handicap intellectuel (IME, MAS, CAJ).</p>
        </li>
        <li class="rv">
          <span class="t-title">Psychopraticien en PNL</span>
          <span class="t-meta">Profession libérale · 2005 – 2012</span>
          <p class="t-desc">PNL et gestion du stress traumatique.</p>
        </li>
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="rv">Certifications &amp; formations</h2>
      <ul class="certs rv">
        <li><div class="c-main"><b>Formateur certifié PSSM Jeune</b><span>Premiers Secours en Santé Mentale France</span></div><time>2025</time></li>
        <li><div class="c-main"><b>RS 7680 · Bilan de compétences</b><span>Professionnaliser la pratique du bilan de compétences</span></div><time>2025</time></li>
        <li><div class="c-main"><b>RS 6899 · VAE</b><span>Professionnaliser l'accompagnement en validation des acquis de l'expérience</span></div><time>2025 – 2026</time></li>
        <li><div class="c-main"><b>Formateur professionnel d'adultes</b><span>Afpa</span></div><time>2023 – 2024</time></li>
        <li><div class="c-main"><b>PNL humaniste</b><span>Maître praticien, puis psychopraticien</span></div><time>1999 – 2012</time></li>
      </ul>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <h2 class="rv">Contact</h2>
      <div class="contact-card rv">
        <div class="c-row" id="row-tel" hidden>
          <div class="c-text"><small>Téléphone</small><a id="tel" href="#"></a></div>
          <button class="copy" type="button" data-copy="tel">Copier</button>
        </div>
        <div class="c-row" id="row-mail" hidden>
          <div class="c-text"><small>E-mail</small><a id="mail" href="#"></a></div>
          <button class="copy" type="button" data-copy="mail">Copier</button>
        </div>
        <div class="c-row">
          <div class="c-text"><small>LinkedIn</small><a href="https://www.linkedin.com/in/guillaume-avenel-538063204/" target="_blank" rel="noopener">guillaume-avenel</a></div>
        </div>
      </div>
    </div>
  </section>

  <footer><div class="wrap">Guillaume Avenel</div></footer>
</main>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
  // ⚠️ À REMPLIR. Les éléments liés à un champ vide restent cachés.
  const CONTACT = {
    firstName: "Guillaume",
    lastName: "Avenel",
    title: "Formateur professionnel d'adultes",
    phone: "+33 6 83 83 75 38",   // ex : "+33 6 12 34 56 78"
    email: "guillaumeavenel@orange.fr",   // ex : "prenom@exemple.fr"
    photo: "data:image/jpeg;base64,",   // ex : "guillaume.jpg" (carré, ≥ 400 px). Initiales si vide ou introuvable.
    url: "https://www.linkedin.com/in/guillaume-avenel-538063204/"
  };

  const $ = id => document.getElementById(id);
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* Contact */
  if (CONTACT.phone){
    $("tel").textContent = CONTACT.phone;
    $("tel").href = "tel:" + CONTACT.phone.replace(/[^\d+]/g, "");
    $("row-tel").hidden = false;
  }
  if (CONTACT.email){
    $("mail").textContent = CONTACT.email;
    $("mail").href = "mailto:" + CONTACT.email;
    $("row-mail").hidden = false;
  }
  if (CONTACT.phone || CONTACT.email){
    $("vcard").hidden = false;
  } else {
    $("li-hero").classList.add("primary");   // pas de bouton vide : LinkedIn devient l'action principale
  }

  /* Photo (avec repli sur les initiales) */
  if (CONTACT.photo){
    const img = new Image();
    img.alt = "Portrait de " + CONTACT.firstName + " " + CONTACT.lastName;
    img.onload = () => $("portrait").appendChild(img);
    img.src = CONTACT.photo;
  }

  /* vCard */
  $("vcard").addEventListener("click", () => {
    const esc = s => String(s).replace(/([,;\\])/g, "\\$1");
    const vcf = [
      "BEGIN:VCARD", "VERSION:3.0",
      `N:${esc(CONTACT.lastName)};${esc(CONTACT.firstName)};;;`,
      `FN:${esc(CONTACT.firstName)} ${esc(CONTACT.lastName)}`,
      `TITLE:${esc(CONTACT.title)}`,
      CONTACT.phone ? `TEL;TYPE=CELL:${CONTACT.phone}` : "",
      CONTACT.email ? `EMAIL:${CONTACT.email}` : "",
      `URL:${CONTACT.url}`,
      "END:VCARD"
    ].filter(Boolean).join("\r\n");
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([vcf], {type: "text/vcard"}));
    a.download = "Guillaume-Avenel.vcf";
    document.body.appendChild(a); a.click(); a.remove();
    toast("Fiche contact téléchargée");
  });

  /* Toast léger (transitions, pas de keyframes : se réarme proprement si on clique vite) */
  let tTimer;
  function toast(msg){
    const el = $("toast");
    el.textContent = msg;
    el.classList.add("on");
    clearTimeout(tTimer);
    tTimer = setTimeout(() => el.classList.remove("on"), 2200);
  }

  document.querySelectorAll("[data-copy]").forEach(btn => {
    btn.addEventListener("click", async () => {
      const value = CONTACT[btn.dataset.copy === "tel" ? "phone" : "email"];
      try {
        await navigator.clipboard.writeText(value);
        toast("Copié");
      } catch {
        toast("Copie impossible, sélectionne le texte");
      }
    });
  });

  /* Barre : le nom apparaît quand le titre sort de l'écran */
  const bar = $("bar");
  new IntersectionObserver(([e]) => bar.classList.toggle("show", !e.isIntersecting), {rootMargin: "-56px 0px 0px 0px"})
    .observe(document.querySelector("h1"));

  /* Apparition au scroll : une seule fois, léger décalage dans les groupes */
  document.querySelectorAll("[data-stagger]").forEach(group =>
    [...group.children].forEach((child, i) => child.style.setProperty("--i", i))
  );
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target); } });
  }, {threshold: 0.12, rootMargin: "0px 0px -6% 0px"});
  document.querySelectorAll(".rv").forEach(el => io.observe(el));
</script>
</body>
</html>
